# Copy this file to .env and fill in real values. Never commit the real .env
# file (it's already listed in .gitignore).

# Port the server listens on.
PORT=3000

# Your Formspree endpoint — used server-side to relay a copy of each RSVP so
# you still get an email notification. The free plan is enough for this:
# we only ever POST to it, never read submissions back.
FORMSPREE_ENDPOINT=https://formspree.io/f/mqpkawzq

# MySQL connection — this is where RSVPs actually get stored and read back
# from for the hidden admin page. The database itself (DB_NAME) must
# already exist — server.js creates the `rsvps` TABLE inside it
# automatically on startup, but not the database. See README.md.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wedding_rsvps

# Password required to unlock the live RSVP list on rsvp-admin.html.
# Pick something only you and your partner know — this is the only thing
# protecting your guest list (names/emails/dietary info) once this is live.
ADMIN_PASSWORD=
